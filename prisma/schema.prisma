// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Products
model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  category  String
  unit      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory        Inventory[]
  transactions     Transaction[]
  productSettings  ProductSetting?
  alerts           Alert[]
  batches          ProductBatch[]
  productSuppliers ProductSupplier[]
  purchaseOrders   PurchaseOrder[]
}

// 2. Warehouses
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  location  String
  type      String?  // e.g., "Regional", "Mobile", "Retail", "Temporary"
  status    String?  @default("Active") // "Active", "Inactive"
  parentId  String?  // For warehouse hierarchy
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory               Inventory[]
  sourceTransactions      Transaction[]  @relation("SourceWarehouse")
  destinationTransactions Transaction[]  @relation("DestinationWarehouse")
  batches                 ProductBatch[]
  parent                  Warehouse?    @relation("WarehouseHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children                 Warehouse[]   @relation("WarehouseHierarchy")

  @@index([parentId])
  @@index([status])
  @@index([type])
}

// 3. Inventory
model Inventory {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

// 4. Transactions
enum TransactionType {
  IN
  OUT
  TRANSFER
  RETURN
  USAGE
}

model Transaction {
  id                     String          @id @default(cuid())
  productId              String
  sourceWarehouseId      String?
  destinationWarehouseId String?
  quantity               Int
  type                   TransactionType
  userId                 String?
  reason                 String?
  department             String?
  timestamp              DateTime        @default(now())
  createdAt              DateTime        @default(now())

  product              Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceWarehouse      Warehouse? @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse? @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  user                 User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([timestamp])
  @@index([userId])
  @@index([type])
}

// 5. Product Settings
model ProductSetting {
  id            String   @id @default(cuid())
  productId     String   @unique
  minStockLevel Int      @default(0)
  safetyStock   Int      @default(0)
  leadTimeDays  Int      @default(7)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// 6. Alerts
enum AlertStatus {
  NEW
  READ
}

model Alert {
  id        String      @id @default(cuid())
  productId String
  message   String
  status    AlertStatus @default(NEW)
  createdAt DateTime    @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

// 7. Product Batches
model ProductBatch {
  id          String    @id @default(cuid())
  productId   String
  batchNumber String
  expiryDate  DateTime?
  quantity    Int
  warehouseId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  expiryAlerts ExpiryAlert[]

  @@unique([productId, batchNumber, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@index([expiryDate])
}

// 8. Expiry Alerts
model ExpiryAlert {
  id        String      @id @default(cuid())
  batchId   String
  message   String
  status    AlertStatus @default(NEW)
  createdAt DateTime    @default(now())

  batch ProductBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([status])
}

// 9. Suppliers
model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  productSuppliers ProductSupplier[]
  purchaseOrders   PurchaseOrder[]
}

// 10. Product Suppliers
model ProductSupplier {
  id         String   @id @default(cuid())
  productId  String
  supplierId String
  price      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([productId])
  @@index([supplierId])
}

// 11. Purchase Orders
enum PurchaseOrderStatus {
  PENDING
  SENT
  RECEIVED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  supplierId String
  productId  String
  quantity   Int
  status     PurchaseOrderStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([productId])
  @@index([status])
}

// 12. Users
enum UserRole {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?  // Optional for OAuth users
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([email])
}
